-- Host (Kabir_Priv) Control Actions
if isController then
    local function handleDownloadInput()
        local url = ytBox.Text:match("^%s*(.-)%s*$")
        if url == "" then
            statusLbl.Text = "Status: Enter a valid YouTube URL"
            return
        end

        ytBox.Text = ""

        -- Send raw URL via Firebase to trigger background download on listener clients
        firebaseSet("sessionUrl", {url = url, timestamp = os.time()})

        if activeTrack and activeTrack.IsPlaying then
            table.insert(audioQueue, url)
            statusLbl.Text = "Queued URL (" .. #audioQueue .. " in queue)"
        else
            table.insert(audioQueue, url)
            playNextInQueue()
        end
        
        task.delay(5, refreshLibrary)
    end

    dlBtn.MouseButton1Click:Connect(handleDownloadInput)
    ytBox.FocusLost:Connect(function(enter) if enter then handleDownloadInput() end end)

    playBtn.MouseButton1Click:Connect(function()
        if activeTrack then 
            activeTrack:Play() 
            statusLbl.Text = "Playing: " .. activeTrackName:sub(1, 24)
            firebaseSet("sessionState", {action = "resume", timestamp = os.time()})
        end
    end)

    pauseBtn.MouseButton1Click:Connect(function()
        if activeTrack then 
            activeTrack:Pause() 
            statusLbl.Text = "Status: Paused"
            firebaseSet("sessionState", {action = "pause", timestamp = os.time()})
        end
    end)

    nextBtn.MouseButton1Click:Connect(function()
        stopCurrentTrack()
        playNextInQueue()
    end)

    queueAllBtn.MouseButton1Click:Connect(function()
        if isfolder and isfolder("TATrMusic/") then
            for _, filePath in ipairs(listfiles("TATrMusic/")) do
                if filePath:match("%.mp3$") then
                    local fileName = filePath:match("[^\\/]+%.mp3$"):gsub("%.mp3$", "")
                    table.insert(audioQueue, {path = filePath, name = fileName})
                end
            end
            statusLbl.Text = "Queued all local tracks (" .. #audioQueue .. " in queue)"
            if not activeTrack or not activeTrack.IsPlaying then
                playNextInQueue()
            end
        end
    end)
end

-- Listener Sync & Download Trigger Engine
if not isController then
    local lastUrlTimestamp = 0

    task.spawn(function()
        while task.wait(1.5) do
            -- 1. Check for newly pushed URL to download in background
            local urlData = firebaseGet("sessionUrl")
            if urlData and type(urlData) == "table" and urlData.timestamp and urlData.timestamp > lastUrlTimestamp then
                lastUrlTimestamp = urlData.timestamp
                if urlData.url and originalMainFrame then
                    for _, desc in ipairs(originalMainFrame:GetDescendants()) do
                        if desc:IsA("TextBox") and desc.PlaceholderText:match("Paste YouTube") then
                            desc.Text = urlData.url
                            local parent = desc.Parent
                            for _, btn in ipairs(parent:GetChildren()) do
                                if btn:IsA("ImageButton") then
                                    for _, conn in ipairs(getconnections(btn.MouseButton1Click)) do
                                        conn:Fire()
                                    end
                                end
                            end
                            break
                        end
                    end
                    task.delay(4, refreshLibrary)
                end
            end

            -- 2. Check for Play/Pause/Stop actions from Host
            local state = firebaseGet("sessionState")
            if state and type(state) == "table" and state.timestamp and state.timestamp > lastSyncTimestamp then
                lastSyncTimestamp = state.timestamp
                
                if state.action == "play" and state.fileName then
                    local targetPath = nil
                    if isfolder and isfolder("TATrMusic/") then
                        for _, path in ipairs(listfiles("TATrMusic/")) do
                            if path:match("[^\\/]+%.mp3$"):gsub("%.mp3$", "") == state.fileName then
                                targetPath = path
                                break
                            end
                        end
                    end
                    
                    if targetPath then
                        playFile(targetPath, state.fileName, false)
                    else
                        statusLbl.Text = "Syncing... Downloading track: " .. state.fileName:sub(1, 16)
                    end
                elseif state.action == "pause" and activeTrack then
                    activeTrack:Pause()
                    statusLbl.Text = "Status: Paused by Kabir_Priv"
                elseif state.action == "resume" and activeTrack then
                    activeTrack:Play()
                    statusLbl.Text = "Playing: " .. activeTrackName:sub(1, 20)
                elseif state.action == "stop" then
                    stopCurrentTrack()
                    statusLbl.Text = "Status: Stopped by Kabir_Priv"
                end
            end
        end
    end)
end

-- 6. Background Inactivity Monitor (9-Minute Deletion Engine)
task.spawn(function()
    while task.wait(1) do
        if activeTrack and activeTrack.IsPlaying then
            inactiveTimer = 0
        else
            inactiveTimer = inactiveTimer + 1
            if inactiveTimer >= INACTIVE_LIMIT then
                inactiveTimer = 0
                purgeLibrary()
            end
        end
    end
end)

