local refreshLibrary, playFile, playNextInQueue

local function purgeLibrary()
    if isfolder and isfolder("TATrMusic/") and delfile then
        local files = listfiles("TATrMusic/")
        for _, filePath in ipairs(files) do
            if filePath:match("%.mp3$") then
                pcall(function() delfile(filePath) end)
            end
        end
        statusLbl.Text = "Status: Purged local library (9m Inactive)"
        refreshLibrary()
    end
end

playFile = function(filePath, fileName, syncState)
    stopCurrentTrack()
    inactiveTimer = 0

    local sound = Instance.new("Sound")
    sound.Name = "TAT_" .. tick()
    sound.SoundId = getcustomasset and getcustomasset(filePath) or ("rbxasset://" .. filePath)
    sound.Volume = 0.8
    sound.Parent = workspace

    activeTrack = sound
    activeTrackName = fileName

    if origEnv and origEnv.value65 then
        origEnv.value65(sound, fileName)
    else
        sound:Play()
    end

    statusLbl.Text = "Playing: " .. fileName:sub(1, 24)

    -- Broadcast state to Firebase if Controller
    if isController and syncState ~= false then
        lastSyncTimestamp = os.time()
        firebaseSet("sessionState", {
            action = "play",
            fileName = fileName,
            filePath = filePath,
            timestamp = lastSyncTimestamp
        })
    end

    sound.Ended:Connect(function()
        stopCurrentTrack()
        if isController then
            playNextInQueue()
        end
    end)
end

playNextInQueue = function()
    if not isController then return end
    if #audioQueue > 0 then
        local nextItem = table.remove(audioQueue, 1)
        if type(nextItem) == "string" and nextItem:match("^https?://") then
            statusLbl.Text = "Status: Downloading queued URL..."
            if originalMainFrame then
                for _, desc in ipairs(originalMainFrame:GetDescendants()) do
                    if desc:IsA("TextBox") and desc.PlaceholderText:match("Paste YouTube") then
                        desc.Text = nextItem
                        local parent = desc.Parent
                        for _, btn in ipairs(parent:GetChildren()) do
                            if btn:IsA("ImageButton") then
                                for _, conn in ipairs(getconnections(btn.MouseButton1Click)) do
                                    conn:Fire()
                                end
                            end
                        end
                        break
                    end
                end
            end
        elseif type(nextItem) == "table" then
            playFile(nextItem.path, nextItem.name)
        end
    else
        statusLbl.Text = "Status: Queue ended"
        firebaseSet("sessionState", {action = "stop", timestamp = os.time()})
    end
end

