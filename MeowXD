-- Helper for HTTP requests
local httpRequest = (syn and syn.request) or (http and http.request) or request or HttpService.RequestAsync

local function firebaseSet(path, data)
    if not isController or not httpRequest then return end
    pcall(function()
        httpRequest({
            Url = MUSIC_SESSION_FIREBASE_URL .. path .. ".json",
            Method = "PUT",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode(data)
        })
    end)
end

local function firebaseGet(path)
    if not httpRequest then return nil end
    local response = nil
    pcall(function()
        local res = httpRequest({
            Url = MUSIC_SESSION_FIREBASE_URL .. path .. ".json",
            Method = "GET"
        })
        if res and res.Body then
            response = HttpService:JSONDecode(res.Body)
        end
    end)
    return response
end

